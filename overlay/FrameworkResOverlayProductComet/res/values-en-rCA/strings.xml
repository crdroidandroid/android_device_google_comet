<resources>
    <!-- Message shown during fingerprint acquisision when the fingerprint cannot be recognized -->
    <string name="fingerprint_acquired_partial">Make sure your finger covers the sensor</string>

    <!-- Message shown during fingerprint acquisision when the user removes their finger from the sensor too quickly -->
    <string name="fingerprint_acquired_too_fast">Keep your finger on the sensor a little longer</string>

    <!-- Message shown during fingerprint acquisition when a Power press has been detected.[CHAR LIMIT=50] -->
    <string name="fingerprint_acquired_power_press">To continue setup, lightly touch the sensor</string>

    <!-- Array containing custom messages shown during fingerprint acquisision from vendor.  Vendor is expected to add and translate these strings -->
    <string-array name="fingerprint_acquired_vendor">
        <item>@string/fingerprint_acquired_immobile</item>
    </string-array>

    <!-- Generic error message shown when the power button has been pressed. [CHAR LIMIT=150] -->
    <string name="fingerprint_error_power_pressed">Verification ended. Try touching lightly next time.</string>
</resources>
