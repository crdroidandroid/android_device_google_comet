# Audio
persist.vendor.audio.sw_offload=true

# Bluetooth
bluetooth.ble.client.subrate_le_audio_mode_max_subrate.config=2
bluetooth.ble.client.subrate_le_audio_mode_min_subrate.config=1
bluetooth.core.le.dsa_transport_preference=iso-sw,le-acl
bluetooth.device_id.product_id=16659
bluetooth.hardware.degraded_performance_mode.enabled=true
bluetooth.profile.gmap.enabled=true
persist.bluetooth.bqr.event_mask=295006
persist.bluetooth.sw_offload=true
persist.bluetooth.thread_dispatcher.enabled=false

# Device family
ro.build.device_family=CT3

# Google keyboard
ro.com.google.ime.height_ratio=1.18
ro.com.google.ime.kb_pad_port_b=11.2

# One-handed mode
ro.support_one_handed_mode=false

# Quick start
ro.quick_start.device_id=comet

# Telephony
persist.vendor.ril.camp_on_earlier=1
