# Bluetooth
bluetooth.core.le.dsa_transport_preference=iso-sw,le-acl
bluetooth.device_id.product_id=16659
bluetooth.profile.gmap.enabled=true
persist.bluetooth.bqr.event_mask=295006
persist.bluetooth.leaudio_sw_offload=true
persist.bluetooth.thread_dispatcher.enabled=false
persist.vendor.audio.leaudio_sw_offload=true

# Google keyboard
ro.com.google.ime.height_ratio=1.18
ro.com.google.ime.kb_pad_port_b=11.2

# One-handed mode
ro.support_one_handed_mode=false

# Quick start
ro.quick_start.device_id=comet
